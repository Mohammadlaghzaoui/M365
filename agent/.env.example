# ===== WorkPilot Migration Agent configuration =====
# Copy to .env (or set as real environment variables) and run: npm start

# Port the agent listens on
PORT=8787

# Shared secret — paste the SAME value in the portal (Settings > Integrations > Migration Agent)
# This key gets the super_admin role.
AGENT_API_KEY=change-me-to-a-long-random-string

# RBAC (optional): extra keys with limited roles, enforced SERVER-SIDE — the key
# IS the identity, so a tampered browser cannot escalate. Give each engineer an
# own key. Roles: super_admin | architect | engineer | read_only
# AGENT_KEYS=longrandomkey1:architect,longrandomkey2:engineer,longrandomkey3:read_only

# Audit log file (append-only JSON lines; default: agent/audit.log)
# AUDIT_FILE=C:\WorkPilot\audit.log

# Exchange Online app-only auth (certificate) for migration batches:
# EXO_APP_ID=
# EXO_ORG=tenant.onmicrosoft.com
# EXO_CERT_THUMBPRINT=

# Portal origins allowed to call this agent (comma separated). Leave empty to allow any.
ALLOWED_ORIGINS=https://sorrento.cloud,https://mohammadlaghzaoui.github.io

# Microsoft Graph app-only (Entra app registration with application permissions:
# User.ReadWrite.All, User.Invite.All, Group.ReadWrite.All + admin consent)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# PowerShell executable: powershell.exe (Windows) or pwsh (cross-platform)
POWERSHELL_EXE=powershell.exe

# Which on-prem PS modules are installed on this host (informational, shown in /health)
PS_MODULES=ActiveDirectory,ExchangeOnlineManagement,ExchangePowerShell

# Allow operator-authored raw PowerShell jobs (/powershell/run). Keep false unless trusted.
ALLOW_RAW_POWERSHELL=false

# SSL/TLS — serve the agent over HTTPS directly (PEM files). Recommended for any
# networked deployment. Leave empty to run HTTP (localhost) or behind a proxy.
# TLS_CERT_FILE=C:\WorkPilot\certs\fullchain.pem
# TLS_KEY_FILE=C:\WorkPilot\certs\privkey.pem
# TLS_CA_FILE=C:\WorkPilot\certs\chain.pem
# HOST=0.0.0.0
